<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>เข้าสู่ระบบ</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container my-5" style="max-width: 400px;">
    <div class="card p-4 shadow-sm">
      <h4 class="text-center mb-3">เข้าสู่ระบบ</h4>
      <form action="/login" method="POST">
        <input type="text" name="username" class="form-control mb-2" placeholder="ชื่อผู้ใช้" required>
        <input type="password" name="password" class="form-control mb-3" placeholder="รหัสผ่าน" required>
        <button class="btn btn-primary w-100">เข้าสู่ระบบ</button>
      </form>
    </div>
  </div>
</body>
</html>