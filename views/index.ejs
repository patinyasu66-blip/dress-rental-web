    <a href="tel:021234567" class="btn-float btn-phone" title="โทรสอบถาม">
      <i class="bi bi-telephone-fill"></i>
    </a>
  </div>

  <!-- Footer (ปรับแก้ไขให้ตัวหนังสือขาว-ทองสว่าง อ่านชัดเจน 100%) -->
  <footer>
    <div class="container">
      <div class="row g-4">
        <div class="col-12 col-md-4">
          <h5 class="brand-logo mb-3"><i class="bi bi-gem me-2"></i>GLAMOUR RENTAL</h5>
          <p class="mb-3">บริการเช่าชุดราตรี ชุดไทย และชุดสูทระดับพรีเมียม ตอบโจทย์ทุกโอกาสสำคัญของคุณด้วยดีไซน์อันเปี่ยมเสน่ห์</p>
