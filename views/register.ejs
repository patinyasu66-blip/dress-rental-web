<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>สมัครสมาชิก</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container my-5" style="max-width: 500px;">
    <div class="card p-4 shadow-sm">
      <h4 class="text-center mb-3">สมัครสมาชิกผู้เช่า</h4>
      <form action="/register" method="POST">
        <input type="text" name="fullname" class="form-control mb-2" placeholder="ชื่อ-นามสกุล" required>
        <input type="text" name="phone" class="form-control mb-2" placeholder="เบอร์โทรศัพท์" required>
        <textarea name="address" class="form-control mb-2" placeholder="ที่อยู่" required></textarea>
        <input type="text" name="username" class="form-control mb-2" placeholder="ชื่อผู้ใช้ (Username)" required>
        <input type="password" name="password" class="form-control mb-3" placeholder="รหัสผ่าน" required>
        <button class="btn btn-success w-100">ยืนยันสมัครสมาชิก</button>
      </form>
    </div>
  </div>
</body>
</html>